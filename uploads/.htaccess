Options -Indexes -ExecCGI

# Never execute anything stored in uploads
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps

<FilesMatch "\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|shtml|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
